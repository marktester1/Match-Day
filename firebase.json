{
  "hosting": {
    "public": "public",
    "predeploy": [
      "sh tools/build_public.sh"
    ],
    "headers": [
      {
        "source": "**/@(index.html|sw.js|firebase-config.js|manifest.webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8095
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
