{
  "hosting": {
    "site": "matchday-website-preview",
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "Strict-Transport-Security", "value": "max-age=31536000"},
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
          {"key": "X-Frame-Options", "value": "DENY"},
          {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' https://match-day-17b23.web.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
        ]
      },
      {"source": "img/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]}
    ]
  }
}
